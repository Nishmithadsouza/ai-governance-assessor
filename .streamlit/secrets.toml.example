# Copy this file to .streamlit/secrets.toml for local use, or paste its
# contents into the "Secrets" box in the Streamlit Community Cloud app
# settings for the hosted deployment. Never commit the real secrets.toml.

# Optional. Without this, the app works fully but narratives are generated
# by the built-in deterministic template instead of Gemini.
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"

# Optional. Without these, the app uses a local SQLite file, which is fine
# for local runs and for grading, but will not survive a Streamlit Community
# Cloud container restart. See README "Persistent hosting with Turso".
TURSO_DATABASE_URL = ""
TURSO_AUTH_TOKEN = ""
